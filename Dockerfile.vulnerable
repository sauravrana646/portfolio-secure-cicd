# INTENTIONALLY INSECURE — for local before/after demos only. CI builds Dockerfile.
# Problems: root user, fat base, pip as root, secrets-ish pattern, no multi-stage.
FROM python:3.9
WORKDIR /app
COPY app/requirements.txt .
RUN pip install -r requirements.txt
COPY app/ ./app/
# Bad practice: leftover package managers and root.
# Do not put real secrets in images. (Intentional anti-pattern documented in README —
# no credential-shaped ENV here so CI secret scanners stay clean.)
EXPOSE 8080
CMD ["python", "app/main.py"]
